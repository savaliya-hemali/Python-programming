## 2.g : Matrix operations ##

import numpy as np
A = np.array([
    [1, 2],
    [3, 4]
])

B = np.array([
    [5, 6],
    [7, 8]
])

addition = A + B
subtraction = A - B

print("Matrix operations")
print("Addition:")
print(addition)
print("Subtraction:")
print(subtraction)

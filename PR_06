## 6.d : Binomial distribution ##

import numpy as np
import matplotlib.pyplot as plt

binomial_data = np.random.binomial(n=10, p=0.5, size=10000)

print("First 20 Values:", binomial_data[:20])
print("Mean:", np.mean(binomial_data))

plt.figure()
plt.hist(binomial_data, bins=np.arange(-0.5, 11.5, 1))
plt.xlabel("Number of Successes")
plt.ylabel("Frequency")
plt.title("Binomial Distribution")
plt.show()

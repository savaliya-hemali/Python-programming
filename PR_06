## 6.a : Coin toss ##

import numpy as np
import matplotlib.pyplot as plt

tosses = np.random.choice(["Head", "Tail"], size=10000)

heads = np.sum(tosses == "Head")
tails = np.sum(tosses == "Tail")
probability_heads = heads / len(tosses)

print("Number of Heads:", heads)
print("Number of Tails:", tails)
print("Estimated Probability of Head:", probability_heads)

plt.figure()
plt.bar(["Head", "Tail"], [heads, tails])
plt.xlabel("Outcome")
plt.ylabel("Frequency")
plt.title("Coin Toss Distribution")
plt.show()

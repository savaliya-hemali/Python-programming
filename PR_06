## 6.b : Dice ##

import numpy as np
import matplotlib.pyplot as plt

rolls = np.random.randint(1, 7, size=10000)

print("First 20 Rolls:", rolls[:20])
print("Average Dice Value:", np.mean(rolls))

six_count = np.sum(rolls == 6)
probability_six = six_count / len(rolls)

print("Number of Sixes:", six_count)
print("Estimated Probability of Six:", probability_six)

values, counts = np.unique(rolls, return_counts=True)

plt.figure()
plt.bar(values, counts)
plt.xlabel("Dice Outcome")
plt.ylabel("Frequency")
plt.title("Distribution of 10,000 Dice Rolls")
plt.show()

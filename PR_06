## 6.f : Random sampling ##
import numpy as np
import matplotlib.pyplot as plt

population = np.random.normal(60, 10, 1000)
sample = np.random.choice(population, size=50, replace=False)

print("Population Size:", len(population))
print("Sample Size:", len(sample))
print("Population Mean:", np.mean(population))
print("Sample Mean:", np.mean(sample))

plt.figure()
plt.hist(population, bins=30, alpha=0.7)
plt.hist(sample, bins=15, alpha=0.7)
plt.xlabel("Value")
plt.ylabel("Frequency")
plt.title("Population and Sample Distribution")
plt.show()

## 8.a : Correlation Analysis ##

import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import pearsonr
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

study_hours = np.array([1, 2, 3, 4, 5, 6, 7, 8])
marks = np.array([35, 40, 50, 55, 65, 70, 75, 85])

print("Study Hours:", study_hours)
print("Marks:", marks)

correlation, p_value = pearsonr(study_hours, marks)

print("\nCorrelation Analysis")
print("Correlation Coefficient:", correlation)
print("P-value:", p_value)
-------------------------------------------------------
## 8.b : Manual Least Squares Regression ##

x_mean = np.mean(study_hours)
y_mean = np.mean(marks)

numerator = np.sum((study_hours - x_mean) * (marks - y_mean))
denominator = np.sum((study_hours - x_mean) ** 2)

slope = numerator / denominator
intercept = y_mean - slope * x_mean

print("\nLeast Squares Regression")
print("Slope:", slope)
print("Intercept:", intercept)
print("Regression Equation: Y =", intercept, "+", slope, "X")
-------------------------------------------------
## 8.c : Prediction Using Linear Regression ##

X = study_hours.reshape(-1, 1)
Y = marks

model = LinearRegression()
model.fit(X, Y)

print("\nScikit-learn Regression")
print("Slope:", model.coef_[0])
print("Intercept:", model.intercept_)

predicted_values = model.predict(X)

print("\nPredicted Values:")
print(predicted_values)

mse = mean_squared_error(Y, predicted_values)
r2 = r2_score(Y, predicted_values)

print("\nModel Evaluation")
print("Mean Squared Error:", mse)
print("R-squared:", r2)
---------------------------------------------
## 8.d : Visualization ##

plt.scatter(study_hours, marks, label="Actual Data")
plt.plot(study_hours, predicted_values, label="Regression Line")
plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.title("Simple Linear Regression: Study Hours vs Marks")
plt.legend()
plt.show()

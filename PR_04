## 4.a : Create line Plot ##

import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

data = {
    "maths": [80, 85, 90, 95, 98, 75],
    "science": [90, 45, 67, 78, 89, 56],
    "english": [56, 89, 67, 77, 89, 44]
}

df = pd.DataFrame(data)

plt.plot(df["maths"], label="Maths")
plt.plot(df["science"], label="Science")
plt.plot(df["english"], label="English")
plt.xlabel("Students")
plt.ylabel("Marks")
plt.title("Marks of Students")
plt.legend()
plt.show()

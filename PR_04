## 4.c : Create Pie Chart ##

import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

data = {
    "maths": [80, 85, 90, 95, 98, 75],
    "science": [90, 45, 67, 78, 89, 56],
    "english": [56, 89, 67, 77, 89, 44]
}

df = pd.DataFrame(data)
marks = df.mean()

plt.pie(
    marks,
    labels=marks.index,
    autopct="%1.1f%%"
)

plt.title("Average Marks by Subject")
plt.show()
